    {
      "name": "Login uden felter – valideringsfejl",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Statuskode er 400', function () {",
            "    pm.response.to.have.status(400);",
            "});",
            "pm.test('Content-Type indeholder application/problem+json', function () {",
            "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
            "});",
            "pm.test('Manglende brugernavn og adgangskode giver valideringsfejl uden token', function () {",
            "    const data = pm.response.json();",
            "    pm.expect(data.status).to.eql(400);",
            "    pm.expect(data.errors).to.be.an('object');",
            "    pm.expect(Object.keys(data.errors).map(key => key.toLowerCase())).to.include.members(['username', 'password']);",
            "    pm.expect(data).not.to.have.property('token');",
            "    pm.expect(data).not.to.have.property('password');",
            "    pm.expect(data).not.to.have.property('passwordHash');",
            "});"
          ]
        }
      }]
