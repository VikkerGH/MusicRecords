  "event": [{
    "listen": "prerequest",
    "script": {
      "type": "text/javascript",
      "exec": [
        "if (pm.request.method === 'POST' && pm.request.body && pm.request.body.mode === 'raw') {",
        "    const body = JSON.parse(pm.request.body.raw);",
        "    ['username', 'password'].forEach(function (field) {",
        "        if (typeof body[field] === 'string') {",
        "            const variable = /^\\{\\{(\\w+)\\}\\}$/.exec(body[field]);",
        "            if (variable) body[field] = pm.variables.get(variable[1]) || '';",
        "        }",
        "    });",
        "    pm.request.body.update(JSON.stringify(body));",
        "}"
      ]
    }
  }],
