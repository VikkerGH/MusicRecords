    {
      "name": "Login som User – korrekt login og lokalt token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{userUsername}}\",\n  \"password\": \"{{userPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Statuskode er 200', function () {",
            "    pm.response.to.have.status(200);",
            "});",
            "pm.test('Content-Type indeholder application/json', function () {",
            "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
            "});",
            "pm.test('User-svaret er korrekt uden hemmeligheder, og token gemmes lokalt', function () {",
            "    pm.response.to.have.status(200);",
            "    const data = pm.response.json();",
            "    pm.expect(data).to.have.all.keys('token', 'expiresAtUtc', 'username', 'role');",
            "    pm.expect(data.username).to.eql(pm.variables.get('userUsername'));",
            "    pm.expect(data.role).to.eql('User');",
            "    pm.expect(data.token).to.be.a('string').and.not.empty;",
            "    pm.expect(data.token.split('.')).to.have.lengthOf(3);",
            "    pm.expect(data.expiresAtUtc).to.be.a('string').and.match(/Z$/);",
            "    pm.expect(Date.parse(data.expiresAtUtc)).to.be.within(Date.now() + 29 * 60 * 1000, Date.now() + 31 * 60 * 1000);",
            "    pm.variables.set('token', data.token);",
            "});"
          ]
        }
      }]
    },
