    {
      "name": "Oprettelse af plader – kør sidst",
      "description": "Kør hele mappen i rækkefølge efter de eksisterende tests med lokale loginvariabler. Oprettelsen ændrer listen. Stop og start API'et før en ny samlet kørsel for at gendanne de to eksempelplader. Ingen reset- eller slettefunktion bruges.",
      "event": [{
        "listen": "prerequest",
        "script": {
          "type": "text/javascript",
          "exec": [
            "if (pm.info.requestName === 'Admin-login til oprettelsestests') {",
            "    ['creationAdminToken', 'creationUserToken', 'createdRecordId'].forEach(name => pm.variables.unset(name));",
            "    pm.variables.set('createdRecordTitle', 'Postman-oprettelse-' + pm.variables.replaceIn('{{$guid}}'));",
            "}",
            "if (pm.request.method === 'POST' && pm.request.url.toString().includes('/api/records')) {",
            "    const body = JSON.parse(pm.request.body.raw);",
            "    if (pm.info.requestName === 'Opret plade som Admin – 201') body.title = pm.variables.get('createdRecordTitle');",
            "    if (pm.info.requestName === 'Admin – fremtidigt udgivelsesår giver 400') body.publicationYear = new Date().getUTCFullYear() + 1;",
            "    pm.request.body.update(JSON.stringify(body));",
            "}"
          ]
        }
      }],
      "item": [
        {
          "name": "Admin-login til oprettelsestests",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"{{adminUsername}}\",\"password\":\"{{adminPassword}}\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Admin-login giver 200 og JSON', function () {",
            "    pm.response.to.have.status(200);",
            "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
            "});",
            "pm.test('Gyldigt Admin-token gemmes kun runtime-lokalt', function () {",
            "    pm.response.to.have.status(200);",
            "    const data = pm.response.json();",
            "    pm.expect(data).to.have.all.keys('token', 'expiresAtUtc', 'username', 'role');",
            "    pm.expect(data.username).to.eql(pm.variables.get('adminUsername'));",
            "    pm.expect(data.role).to.eql('Admin');",
            "    pm.expect(data.token).to.be.a('string').and.not.empty;",
            "    pm.expect(Date.parse(data.expiresAtUtc)).to.be.above(Date.now());",
            "    pm.variables.set('creationAdminToken', data.token);",
            "});"
          ] } }]
        },
        {
          "name": "Opret plade som Admin – 201",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{creationAdminToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"title\":\"Postman-oprettelse\",\"artist\":\"Postman Kunstner\",\"duration\":180,\"publicationYear\":2025}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/records"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Admin-oprettelse giver 201 og JSON', function () {",
            "    pm.response.to.have.status(201);",
            "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
            "});",
            "pm.test('Serveren tildeler et nyt id og returnerer alle korrekte felter', function () {",
            "    pm.response.to.have.status(201);",
            "    const record = pm.response.json();",
            "    pm.expect(record).to.have.all.keys('id', 'title', 'artist', 'duration', 'publicationYear');",
            "    pm.expect(Number.isInteger(record.id)).to.eql(true);",
            "    pm.expect(record.id).to.be.above(2);",
            "    pm.expect(record).to.include({ title: pm.variables.get('createdRecordTitle'), artist: 'Postman Kunstner', duration: 180, publicationYear: 2025 });",
            "    pm.variables.set('createdRecordId', record.id);",
            "});"
          ] } }]
        },
        {
          "name": "Find den oprettede plade med offentlig titelsøgning",
          "request": {
            "method": "GET", "auth": { "type": "noauth" }, "header": [],
            "url": "{{baseUrl}}/api/records?title={{createdRecordTitle}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
