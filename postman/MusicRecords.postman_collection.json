{
  "info": {
    "_postman_id": "4e92caa5-e0e6-4a2d-bfb1-c811ae107d16",
    "name": "MusicRecords",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Hent alle plader uden filtre",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/records"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Statuskode er 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Content-Type indeholder application/json', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "",
              "pm.test('Svaret er et array', function () {",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});",
              "",
              "pm.test('Svaret indeholder præcis 2 plader', function () {",
              "    pm.expect(pm.response.json()).to.have.lengthOf(2);",
              "});",
              "",
              "pm.test('Begge eksempelplader har forventede id’er og feltværdier', function () {",
              "    const records = pm.response.json();",
              "    pm.expect(records).to.be.an('array').with.lengthOf(2);",
              "",
              "    const firstRecord = records.find(record => record.id === 1);",
              "    pm.expect(firstRecord).to.exist;",
              "    pm.expect(firstRecord).to.include({",
              "        id: 1,",
              "        title: 'Ta på mine frugter',",
              "        artist: 'Appelsinsovs',",
              "        duration: 3660,",
              "        publicationYear: 2025",
              "    });",
              "",
              "    const secondRecord = records.find(record => record.id === 2);",
              "    pm.expect(secondRecord).to.exist;",
              "    pm.expect(secondRecord).to.include({",
              "        id: 2,",
              "        title: 'Citrusdrømme',",
              "        artist: 'Appelsinsovs',",
              "        duration: 2823,",
              "        publicationYear: 2026",
              "    });",
              "});"
            ]
          }
        }
      ]
    },
