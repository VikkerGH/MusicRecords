        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{userUsername}}\",\n  \"password\": \"{{invalidPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/login"
