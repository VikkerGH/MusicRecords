      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Statuskode er 401', function () {",
            "    pm.response.to.have.status(401);",
            "});",
            "pm.test('Content-Type indeholder application/json', function () {",
            "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
            "});",
            "pm.test('Forkert adgangskode giver generel fejl uden token eller hemmeligheder', function () {",
            "    const data = pm.response.json();",
            "    pm.expect(data).to.have.all.keys('message');",
            "    pm.expect(data.message).to.eql('Forkert brugernavn eller adgangskode.');",
            "});"
          ]
